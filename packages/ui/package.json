{
  "name": "@argonautical/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser UI for the Forecast Pipeline Demonstrator, plus the explanatory site shell.",
  "scripts": {
    "boundary": "node ../sim/scripts/check-boundary.mjs --json src/generated/boundary.json",
    "predev": "npm run boundary",
    "dev": "vite",
    "prebuild": "npm run boundary",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "npm run boundary && tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@argonautical/sim": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2"
  }
}
